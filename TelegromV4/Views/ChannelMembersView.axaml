<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.ChannelMembersView"
             x:DataType="vm:ChannelMembersViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <Border Background="#2D2D30"
            CornerRadius="10"
            Padding="20"
            Width="350">
        <StackPanel Spacing="15">
            <TextBlock Text="Участники канала"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            
            <ScrollViewer Height="300">
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5"
                                    Padding="10"
                                    Background="#3D3D40"
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"
                                               Foreground="White">
                                        <Run Text="{Binding Nickname}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding Role}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <Button Content="✖ Закрыть"
                    Command="{Binding CloseCommand}"
                    Background="#555555"
                    Foreground="White"/>
        </StackPanel>
    </Border>
</UserControl>