<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.ChatSettingsView"
             x:DataType="vm:ChatSettingsViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <Border Background="#2D2D30"
            CornerRadius="10"
            Padding="20">
        <Grid ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto,*,Auto">
            
            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="Настройки чата"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            
            <!-- Левая колонка - Информация -->
            <StackPanel Grid.Row="1"
                       Grid.Column="0"
                       Spacing="10">
                <TextBlock Text="Название чата"
                           Foreground="Gray"/>
                <TextBlock Text="{Binding ChatName}"
                           FontSize="16"
                           FontWeight="Bold"/>
                
                <TextBlock Text="Ваша роль"
                           Foreground="Gray"
                           Margin="0,10,0,0"/>
                <TextBlock Text="{Binding CurrentUserRole}"
                           FontSize="14"/>
            </StackPanel>

            <!-- Смена аватара -->
<TextBlock Text="Сменить аватар"
           Foreground="Gray"
           Margin="0,10,0,0"/>
<Button Content="📁 Выбрать аватар"
        Command="{Binding SelectAvatarCommand}"
        Background="#555555"
        Foreground="White"/>
<Button Content="Сохранить аватар"
        Command="{Binding ChangeAvatarCommand}"
        Background="#4CAF50"
        Foreground="White"
        Margin="0,5,0,0"/>
            
            <!-- Правая колонка - Изменение названия -->
            <StackPanel Grid.Row="1"
                       Grid.Column="1"
                       Spacing="10">
                <TextBlock Text="Изменить название"
                           Foreground="Gray"/>
                <TextBox Text="{Binding NewChatName}"
                         IsEnabled="{Binding CanManage}"/>
                <Button Content="Сохранить"
                        Command="{Binding ChangeNameCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        IsEnabled="{Binding CanManage}"/>
            </StackPanel>
            
            <!-- Участники -->
            <Border Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Background="#1E1E1E"
                   CornerRadius="5"
                   Margin="0,15"
                   Padding="10">
                <Grid ColumnDefinitions="*,*">
                    <!-- Список участников -->
                    <StackPanel Grid.Column="0"
                               Spacing="10">
                        <TextBlock Text="Участники"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding Members}"
                                 SelectedItem="{Binding SelectedMember}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="5">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold">
                                                <Run Text="{Binding Nickname}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding Role}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding JoinedAt}"
                                                       FontSize="10"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <StackPanel Orientation="Horizontal"
                                   Spacing="5">
                            <Button Content="👑 Назначить админом"
                                    Command="{Binding MakeAdminCommand}"
                                    Background="#FF9800"
                                    Foreground="White"
                                    IsEnabled="{Binding CanManage}"/>
                            <Button Content="⭐ Снять админа"
                                    Command="{Binding RemoveAdminCommand}"
                                    Background="#FF5722"
                                    Foreground="White"
                                    IsEnabled="{Binding CanManage}"/>
                            <Button Content="❌ Удалить"
                                    Command="{Binding RemoveMemberCommand}"
                                    Background="#F44336"
                                    Foreground="White"
                                    IsEnabled="{Binding CanManage}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Добавление участников -->
                    <StackPanel Grid.Column="1"
                               Spacing="10"
                               Margin="15,0,0,0">
                        <TextBlock Text="Добавить участника"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding AvailableUsers}"
                                  SelectedItem="{Binding SelectedUserToAdd}"
                                  PlaceholderText="Выберите пользователя">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nickname}"/>
                                        <TextBlock Text="{Binding Email}"
                                                   FontSize="10"
                                                   Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="➕ Добавить"
                                Command="{Binding AddMemberCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                IsEnabled="{Binding CanManage}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Действия с чатом -->
            <StackPanel Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Orientation="Horizontal"
                       Spacing="10"
                       Margin="0,10,0,0">
                <Button Content="🚪 Покинуть чат"
                        Command="{Binding LeaveChatCommand}"
                        Background="#FF9800"
                        Foreground="White"/>
                <Button Content="🗑️ Удалить чат"
                        Command="{Binding DeleteChatCommand}"
                        Background="#F44336"
                        Foreground="White"
                        IsEnabled="{Binding CanManage}"/>
                <Button Content="✖ Закрыть"
                        Command="{Binding CloseCommand}"
                        Background="#555555"
                        Foreground="White"
                        HorizontalAlignment="Right"
                        Width="100"/>
            </StackPanel>
            
            <TextBlock Grid.Row="4"
                       Grid.ColumnSpan="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="12"
                       IsVisible="{Binding HasError}"
                       Margin="0,10,0,0"/>
            
        </Grid>
    </Border>
</UserControl>