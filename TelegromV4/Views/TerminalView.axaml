<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.TerminalView"
             x:DataType="vm:TerminalViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <Grid ColumnDefinitions="200,*">
        <!-- Левая панель - кнопки -->
        <Border Grid.Column="0"
                Background="#252526">
            <StackPanel Margin="10"
                       Spacing="5">
                <Button Content="👥 Пользователи"
                        Command="{Binding SetUsersTabCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        Height="35"/>
                <Button Content="💬 Группы"
                        Command="{Binding SetChatsTabCommand}"
                        Background="#FF9800"
                        Foreground="White"
                        Height="35"/>
                <Button Content="📢 Каналы"
                        Command="{Binding SetChannelsTabCommand}"
                        Background="#9C27B0"
                        Foreground="White"
                        Height="35"/>
                <Button Content="📋 Логи"
                        Command="{Binding SetLogsTabCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        Height="35"/>
                <Button Content="🔄 Обновить"
                        Command="{Binding RefreshCommand}"
                        Background="#555555"
                        Foreground="White"
                        Height="35"/>
                <Button Content="✖ Закрыть"
                        Command="{Binding CloseCommand}"
                        Background="#F44336"
                        Foreground="White"
                        Height="35"
                        Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Правая панель - содержимое -->
        <ScrollViewer Grid.Column="1"
                      Background="#1E1E1E">
            <StackPanel Margin="15"
                       Spacing="10">
                
                <!-- Заголовок -->
                <TextBlock Text="{Binding SelectedTab}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                
                <!-- Пользователи -->
                <Border Background="#2D2D30"
                        CornerRadius="5"
                        Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TextBlock Text="Список пользователей"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <ListBox ItemsSource="{Binding AllUsers}"
                                 SelectedItem="{Binding SelectedUser}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nickname}"
                                                       FontSize="14"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Email}"
                                                       FontSize="11"
                                                       Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <TextBlock Text="{Binding SelectedUserInfo}"
                                   Margin="0,10,0,0"/>
                        
                        <TextBox PlaceholderText="Причина бана"
                                 Text="{Binding BanReason}"
                                 Margin="0,5"/>
                        
                        <StackPanel Orientation="Horizontal"
                                   Spacing="5">
                            <Button Content="Выдать админа"
                                    Command="{Binding MakeAdminCommand}"
                                    Background="#2196F3"
                                    Foreground="White"/>
                            <Button Content="Забанить"
                                    Command="{Binding BanUserCommand}"
                                    Background="#F44336"
                                    Foreground="White"/>
                            <Button Content="Разбанить"
                                    Command="{Binding UnbanUserCommand}"
                                    Background="#4CAF50"
                                    Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Логи -->
                <Border Background="#2D2D30"
                        CornerRadius="5">
                    <StackPanel Margin="10">
                        <TextBlock Text="Логи"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <ScrollViewer Height="300">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2"
                                                Padding="5">
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Timestamp}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding UserNickname}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding Action}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Details}"
                                                           FontSize="11"
                                                           Foreground="Gray"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>