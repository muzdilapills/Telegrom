<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.TerminalView"
             x:DataType="vm:TerminalViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <Grid ColumnDefinitions="250,*,350">
        <!-- Левая панель - пользователи -->
        <Border Grid.Column="0"
                Background="#252526">
            <StackPanel>
                <Border Height="50"
                        Background="#2D2D30">
                    <TextBlock Text="Пользователи"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                
                <ListBox ItemsSource="{Binding AllUsers}"
                         SelectedItem="{Binding SelectedUser}"
                         Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Nickname}"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Email}"
                                               FontSize="11"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
        
        <!-- Центральная панель - управление пользователем -->
        <Border Grid.Column="1"
                Background="#1E1E1E">
            <StackPanel Margin="15"
                       Spacing="10">
                <TextBlock Text="Управление пользователем"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"/>
                
                <TextBlock Text="{Binding SelectedUserInfo}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
                
                <TextBox Watermark="Причина бана"
                         Text="{Binding BanReason}"/>
                
                <Button Content="👑 Назначить администратором"
                        Command="{Binding MakeAdminCommand}"
                        Background="#2196F3"
                        Foreground="White"/>
                
                <Button Content="🔨 Забанить"
                        Command="{Binding BanUserCommand}"
                        Background="#F44336"
                        Foreground="White"/>
                
                <Button Content="📊 Данные пользователей"
                        Command="{Binding ViewUserDataCommand}"
                        Background="#9C27B0"
                        Foreground="White"/>
            </StackPanel>
        </Border>
        
        <!-- Правая панель - логи -->
        <Border Grid.Column="2"
                Background="#252526">
            <StackPanel>
                <Border Height="50"
                        Background="#2D2D30">
                    <TextBlock Text="Логи"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                
                <ScrollViewer Height="450">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5"
                                        Padding="5"
                                        CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding User}"/>
                                            <Run Text=":"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Action}"
                                                   TextWrapping="Wrap"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <Button Content="✖ Закрыть"
                        Command="{Binding CloseCommand}"
                        Background="#555555"
                        Foreground="White"
                        Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>