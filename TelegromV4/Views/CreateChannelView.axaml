<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.CreateChannelView"
             x:DataType="vm:CreateChannelViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <Border Background="#2D2D30"
            CornerRadius="10"
            Padding="20">
        <StackPanel Spacing="15"
                   Width="400">
            
            <TextBlock Text="Создание канала"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            
            <TextBox PlaceholderText="Название канала"
                     Text="{Binding ChannelName}"
                     FontSize="14"
                     Height="40"/>
            
            <TextBlock Text="Выберите аватар (опционально)"
                       Foreground="Gray"
                       FontSize="12"/>
            <Button Content="📁 Выбрать аватар"
                    Command="{Binding SelectAvatarCommand}"
                    Background="#555555"
                    Foreground="White"/>
            
            <TextBlock Text="Внимание: В канале могут писать только администраторы и создатель!"
                       Foreground="#FF9800"
                       FontSize="12"
                       TextWrapping="Wrap"/>
            
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="12"
                       IsVisible="{Binding HasError}"/>
            
            <Grid ColumnDefinitions="*,*">
    <Button Grid.Column="0"
            Content="Создать"
            Command="{Binding CreateChannelCommand}"
            Background="#4CAF50"
            Foreground="White"
            Height="35"
            Margin="0,0,5,0"/>
    <Button Grid.Column="1"
            Content="Отмена"
            Command="{Binding CancelCommand}"
            Background="#555555"
            Foreground="White"
            Height="35"
            Margin="5,0,0,0"/>
</Grid>
            
        </StackPanel>
    </Border>
</UserControl>