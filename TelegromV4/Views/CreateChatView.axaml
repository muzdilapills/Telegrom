<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.CreateChatView"
             x:DataType="vm:CreateChatViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <Border Background="#2D2D30"
            CornerRadius="10">
        <StackPanel Margin="20"
                    Spacing="15"
                    Width="300">
            
            <TextBlock Text="Создание чата"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            
            <TextBox PlaceholderText="Название чата"
                     Text="{Binding ChatName}"
                     FontSize="14"
                     Height="40"/>
            
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="12"
                       IsVisible="{Binding HasError}"/>
            
            <StackPanel Orientation="Horizontal"
                        Spacing="10">
                <Button Content="Создать"
                        Command="{Binding CreateChatCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        Height="35"
                        Width="140"/>
                <Button Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Background="#555555"
                        Foreground="White"
                        Height="35"
                        Width="140"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>