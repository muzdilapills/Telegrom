<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.RegisterView"
             x:DataType="vm:RegisterViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <StackPanel Spacing="15"
                VerticalAlignment="Center">
        
        <TextBlock Text="Регистрация в Telegrom V4"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBox PlaceholderText="Никнейм"
                 Text="{Binding Nickname}"
                 FontSize="14"
                 Height="40"/>

        <TextBox PlaceholderText="Электронная почта"
                 Text="{Binding Email}"
                 FontSize="14"
                 Height="40"/>

        <TextBox PlaceholderText="Пароль"
                 Text="{Binding Password}"
                 FontSize="14"
                 Height="40"
                 PasswordChar="•"/>

        <TextBox PlaceholderText="Подтверждение пароля"
                 Text="{Binding ConfirmPassword}"
                 FontSize="14"
                 Height="40"
                 PasswordChar="•"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontSize="12"
                   IsVisible="{Binding HasError}"/>

        <Button Content="Зарегистрироваться"
                Command="{Binding RegisterCommand}"
                Background="#4CAF50"
                Foreground="White"
                Height="40"
                FontSize="14"/>

        <Button Content="Уже есть аккаунт? Войти"
                Command="{Binding GoToLoginCommand}"
                Background="Transparent"
                Foreground="#2196F3"
                Height="35"
                FontSize="12"/>
    </StackPanel>
</UserControl>