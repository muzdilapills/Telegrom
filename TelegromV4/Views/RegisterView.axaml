<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TelegromV4.Views.RegisterView"
             x:DataType="vm:RegisterViewModel"
             xmlns:vm="using:TelegromV4.ViewModels">

    <StackPanel Spacing="15"
                VerticalAlignment="Center">
        
        <!-- Аватарка приложения -->
        <Border Width="100"
                Height="100"
                CornerRadius="50"
                Background="#4CAF50"
                HorizontalAlignment="Center">
            <TextBlock Text="T"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <TextBlock Text="Регистрация в Telegrom v4.0"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBox PlaceholderText="Никнейм (только латиница, цифры, _)"
                 Text="{Binding Nickname}"
                 FontSize="14"
                 Height="40"/>

        <TextBox PlaceholderText="Электронная почта"
                 Text="{Binding Email}"
                 FontSize="14"
                 Height="40"/>

        <TextBox PlaceholderText="Пароль (мин. 4 символа)"
                 Text="{Binding Password}"
                 FontSize="14"
                 Height="40"
                 PasswordChar="•"/>

        <TextBox PlaceholderText="Подтверждение пароля"
                 Text="{Binding ConfirmPassword}"
                 FontSize="14"
                 Height="40"
                 PasswordChar="•"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   FontSize="12"
                   IsVisible="{Binding HasError}"/>

        <Button Content="Зарегистрироваться"
                Command="{Binding RegisterCommand}"
                Background="#4CAF50"
                Foreground="White"
                Height="40"
                FontSize="14"/>

        <Button Content="Уже есть аккаунт? Войти"
                Command="{Binding GoToLoginCommand}"
                Background="Transparent"
                Foreground="#2196F3"
                Height="35"
                FontSize="12"/>
    </StackPanel>
</UserControl>